@onum = [zero one two three four five six seven eight nine uniF800 uniF801 uniF802 uniF803 uniF804 uniF805 uniF806 uniF807 uniF808 uniF809];
@onum2 = [uniF832 uniF833 uniF834 uniF835 uniF836 uniF837 uniF838 uniF839 uniF83A uniF83B uniF83C uniF83D uniF83E uniF83F uniF840 uniF841 uniF842 uniF843 uniF844 uniF845];
#/< otclasses
#< classes

#> languagesystem
languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem latn MOL;
languagesystem latn ROM;
languagesystem cyrl dflt;
languagesystem grek dflt;
#< languagesystem
";
tag = Languagesystems;
}
);
features = (
{
code = "# Access All Alternates

#> feature
  feature locl;
  feature sinf;
  feature sups;
  feature subs;
  feature smcp;
  feature salt;
  feature hist;
  feature case;
#< feature";
tag = aalt;
},
{
code = "# Glyph Composition/Decomposition

#> feature
  sub uni0302 acutecomb by uni0302_acutecomb;
  sub uni0302 gravecomb by uni0302_gravecomb;
  sub uni0302 hookabovecomb by uni0302_hookabovecomb;
  sub uni0302 tildecomb by uni0302_tildecomb;
  sub uni0306 acutecomb by uni0306_acutecomb;
  sub uni0306 gravecomb by uni0306_gravecomb;
  sub uni0306 hookabovecomb by uni0306_hookabovecomb;
  sub uni0306 tildecomb by uni0306_tildecomb;
  sub uni030A acutecomb by uni030A_acutecomb;
#< feature";
tag = ccmp;
},
{
code = "# Localized Forms

#> feature
  script cyrl; # Cyrillic
  sub uni0306 by uni0306.cyrl;

  script grek; # Greek
  sub acutecomb by acutecomb.grek;

  script latn; # Latin
  language MOL; # Moldavian
  sub Scedilla by uni0218;
  sub scedilla by uni0219;
  sub uni0162 by uni021A;
  sub uni0163 by uni021B;

  language ROM; # Romanian
  sub Scedilla by uni0218;
  sub scedilla by uni0219;
  sub uni0162 by uni021A;
  sub uni0163 by uni021B;
#< feature";
tag = locl;
},
{
code = "# Scientific Inferiors

#> feature
  sub eight by uni2088;
  sub five by uni2085;
  sub four by uni2084;
  sub nine by uni2089;
  sub one by uni2081;
  sub seven by uni2087;
  sub six by uni2086;
  sub three by uni2083;
  sub two by uni2082;
  sub zero by uni2080;
#< feature";
tag = sinf;
},
{
code = "# Superscript

#> feature
  sub c by uni1D9C;
  sub eight by uni2078;
  sub five by uni2075;
  sub four by uni2074;
  sub n by uni207F;
  sub nine by uni2079;
  sub o by uni1D52;
  sub one by onesuperior;
  sub seven by uni2077;
  sub six by uni2076;
  sub three by threesuperior;
  sub two by twosuperior;
  sub zero by uni2070;
#< feature";
tag = sups;
},
{
code = "# Subscript

#> feature
  sub eight by uni2088;
  sub five by uni2085;
  sub four by uni2084;
  sub nine by uni2089;
  sub one by uni2081;
  sub seven by uni2087;
  sub six by uni2086;
  sub three by uni2083;
  sub two by uni2082;
  sub zero by uni2080;
#< feature";
tag = subs;
},
{
code = "# Fractions

#> feature
lookup frac_precomposed {

  sub one slash four by onequarter;
  sub one slash two by onehalf;
  sub three slash four by threequarters;
  sub one slash three by onethird;
  sub two slash three by twothirds;
  sub one slash eight by oneeighth;
  sub three slash eight by threeeighths;
  sub five slash eight by fiveeighths;
  sub seven slash eight by seveneighths;
  sub one fraction four by onequarter;
  sub one fraction two by onehalf;
  sub three fraction four by threequarters;
  sub one fraction three by onethird;
  sub two fraction three by twothirds;
  sub one fraction eight by oneeighth;
  sub three fraction eight by threeeighths;
  sub five fraction eight by fiveeighths;
  sub seven fraction eight by seveneighths;
} frac_precomposed;
#< feature";
tag = frac;
},
{
code = "# Ordinals

#> feature
  sub [zero one two three four five six seven eight nine] [A a]' by ordfeminine;
  sub [zero one two three four five six seven eight nine] [O o]' by ordmasculine;
  sub N o period by uni2116;
#< feature";
tag = ordn;
},
{
code = "# Small Caps

#> feature
  sub acutecomb by acutecomb.smcp;
  sub fraction by fraction.smcp;
  sub gravecomb by gravecomb.smcp;
  sub uni030B by uni030B.smcp;
  sub uni2080 by uni2080.smcp;
#< feature";
tag = smcp;
},
{
code = "# Stylistic Alternates

#> feature
  sub dieresistonos from [dieresistonos.alt];
#< feature";
tag = salt;
},
{
code = "# Standard Ligatures

#> feature
  sub f f by f_f;
  sub f i by fi;
  sub f l by fl;
  sub f f i by f_f_i;
  sub f f l by f_f_l;
#< feature";
tag = liga;
},
{
code = "# Historical Forms

#> feature
  sub s by longs;
#< feature";
tag = hist;
},
{
code = "# Case Sensitive Forms

#> feature
  sub acutecomb by acutecomb.cap;
  sub acutecomb.grek by acutecomb.grek.cap;
  sub dotbelowcomb by dotbelowcomb.cap;
  sub gravecomb by gravecomb.cap;
  sub hookabovecomb by hookabovecomb.cap;
  sub tildecomb by tildecomb.cap;
  sub uni0302 by uni0302.cap;
  sub uni0304 by uni0304.cap;
  sub uni0304.narrow by uni0304.narrow.cap;
  sub uni0306 by uni0306.cap;
  sub uni0306.cyrl by uni0306.cyrl.cap;
  sub uni0307 by uni0307.cap;
  sub uni0308 by uni0308.cap;
  sub uni0308.narrow by uni0308.narrow.cap;
  sub uni030A by uni030A.cap;
  sub uni030B by uni030B.cap;
  sub uni030C by uni030C.cap;
  sub uni0326 by uni0326.cap;
#< feature";
tag = case;
},
{
code = "# Oldstyle Figures

#> feature
sub @onum by @onum2;
#< feature";
tag = onum;
},
{
code = "# Proportional Figures

#> feature
sub @tnum2 by @tnum;
#< feature";
tag = pnum;
},
{
code = "# Tabular Figures

#> feature
sub @tnum by @tnum2;
#< feature";
tag = tnum;
},
{
code = "# Lining Figures

#> feature
sub @onum2 by @onum;
#< feature";
tag = lnum;
},
{
code = "# Contextual Alternates

#> feature
sub @onum colon' @onum by uni2236;
#< feature";
tag = calt;
}
);
